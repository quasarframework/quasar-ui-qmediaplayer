{
  "name": "docs",
  "version": "3.0.1",
  "private": true,
  "description": "QMediaPlayer Docs",
  "author": "Jeff Galbraith <jeff@quasar.dev>",
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit --pretty false",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "pnpm run build:ssg",
    "postinstall": "quasar prepare --silent",
    "build:spa": "quasar build",
    "build:ssg": "quasar prepare && quasar build && qpress ssg",
    "build:ssg:renderer": "quasar prepare && quasar build -m ssr",
    "prerender:ssg": "qpress ssg",
    "preview:ssg": "quasar serve dist/spa --history",
    "check:qpress": "qpress check"
  },
  "dependencies": {
    "@quasar/extras": "2.0.4",
    "markdown-it": "^15.0.0",
    "markdown-it-container": "^4.0.0",
    "pinia": "^4.0.3",
    "quasar": "^2.25.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@md-plugins/quasar-app-extension-q-press": "2.2.0",
    "@md-plugins/search-ui": "2.2.0",
    "@md-plugins/vite-examples-plugin": "2.2.0",
    "@md-plugins/vite-md-plugin": "2.2.0",
    "@md-plugins/vite-search-plugin": "2.2.0",
    "@md-plugins/vite-ssg-plugin": "2.2.0",
    "@quasar/app-vite": "3.7.0",
    "@quasar/quasar-ui-qmediaplayer": "workspace:*",
    "@types/node": "^26.2.0",
    "@vue/server-renderer": "^3.5.41",
    "autoprefixer": "^10.5.4",
    "mermaid": "^11.17.0",
    "sass-embedded": "1.102.0",
    "shiki": "^4.4.3",
    "typescript": "~6.0.3",
    "vite-plugin-checker": "^0.14.5",
    "vue-tsc": "^3.3.10"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.5.0"
  },
  "productName": "QMediaPlayer Docs"
}
