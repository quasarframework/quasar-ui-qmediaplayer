{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "bracketSpacing": true,
  "files": {
    "ignore": [
      "node_modules",
      "packages/*/node_modules",
      "packages/*/dist",
      "packages/docs/.quasar",
      "packages/docs/dist"
    ]
  }
}
