{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "bracketSpacing": true,
  "ignorePatterns": [
    "node_modules",
    "packages/*/node_modules",
    "packages/*/dist",
    "packages/ui/icon-set",
    "packages/ui/src/version.ts",
    "packages/docs/.quasar",
    "packages/docs/dist"
  ]
}
